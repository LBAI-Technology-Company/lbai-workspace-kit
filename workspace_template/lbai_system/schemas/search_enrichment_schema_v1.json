{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LBAI Search Enrichment v1",
  "type": "object",
  "required": ["schema_version", "query", "result_status", "matches", "next_step"],
  "properties": {
    "schema_version": { "const": "search_enrichment_v1" },
    "query": { "type": "string" },
    "query_interpretation": { "type": "string" },
    "result_status": { "enum": ["FOUND", "NO_MATCH"] },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "match_reason", "suggested_use", "preview"],
        "properties": {
          "path": { "type": "string" },
          "match_reason": { "type": "string" },
          "suggested_use": { "type": "string" },
          "preview": { "type": "string" }
        }
      }
    },
    "next_step": { "type": "string" }
  }
}
