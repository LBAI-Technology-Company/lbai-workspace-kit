{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {
      "const": "prompt_lab_scenarios_v1"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "category", "employee_role", "task_request", "expected_behavior"],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "employee_role": {
            "type": "string",
            "minLength": 1
          },
          "task_request": {
            "type": "string",
            "minLength": 1
          },
          "source_material": {
            "type": "string"
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1
          },
          "risk_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lifecycle": {
            "type": "string",
            "enum": ["evidence_only", "task_intake", "full_chain"]
          },
          "meeting_action_item": {
            "type": "string",
            "description": "For full_chain: the single meeting decision this scenario executes end-to-end."
          },
          "expected_finish_verdict": {
            "type": "string",
            "enum": ["APPROVE_FINISH", "BLOCK_FINISH"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
