{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "rationale", "files"],
  "properties": {
    "schema_version": {
      "const": "prompt_lab_prompt_patch_v1"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prompt_file", "operation"],
        "properties": {
          "prompt_file": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": ["append_rule", "replace_text"]
          },
          "content": {
            "type": "string"
          },
          "find": {
            "type": "string"
          },
          "replace": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
