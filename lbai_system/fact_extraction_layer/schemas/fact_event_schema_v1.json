{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LBAI Fact Event v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "subject",
    "entity",
    "value",
    "status",
    "validity",
    "source",
    "evidence_text"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "fact_event_v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "field_id": { "type": "string" },
    "value": {
      "type": ["string", "number", "integer", "boolean", "object", "array", "null"]
    },
    "status": {
      "enum": ["draft", "proposed", "confirmed", "rejected", "superseded", "open", "closed", "blocked", "unknown"]
    },
    "validity": {
      "type": "object",
      "required": ["source_occurred_at"],
      "additionalProperties": false,
      "properties": {
        "source_occurred_at": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string" },
        "extracted_at": { "type": "string" },
        "valid_from": { "type": "string" },
        "valid_until": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "id", "priority"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "evidence_text": { "type": "string", "minLength": 1 },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "related_to": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}

