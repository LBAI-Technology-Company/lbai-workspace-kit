{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LBAI Fact Extraction Output v1",
  "type": "object",
  "required": [
    "schema_version",
    "task_type",
    "raw_evidence",
    "base_facts",
    "derived_facts",
    "unmapped_facts",
    "field_change_requests",
    "decision_state"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "fact_extraction_output_v1" },
    "task_type": { "type": "string", "minLength": 1 },
    "raw_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/rawEvidence" }
    },
    "base_facts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/factValue" }
    },
    "derived_facts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/factValue" }
    },
    "unmapped_facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/unmappedFact" }
    },
    "field_change_requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldChangeRequest" }
    },
    "decision_state": {
      "type": "object",
      "required": ["state", "missing_facts", "blocked_by", "next_action"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "ready_for_rule_check",
            "needs_fact",
            "needs_schema_change",
            "needs_rule",
            "conflict",
            "blocked"
          ]
        },
        "missing_facts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocked_by": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_action": {
          "enum": ["run_rule_engine", "ask_user", "ask_human", "propose_schema_change", "stop"]
        }
      }
    }
  },
  "$defs": {
    "rawEvidence": {
      "type": "object",
      "required": ["source", "text"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "reference": { "type": "string" }
      }
    },
    "factValue": {
      "type": "object",
      "required": ["value", "source", "evidence_text", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["string", "number", "integer", "boolean", "null"]
        },
        "source": {
          "enum": ["contract", "erp", "crm", "invoice_system", "email", "human_input", "user_text", "derived_rule"]
        },
        "evidence_text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "unmappedFact": {
      "type": "object",
      "required": ["text", "reason", "decision_impact"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "possible_field": { "type": "string" },
        "decision_impact": {
          "enum": ["none", "unknown", "may_affect_decision", "affects_decision"]
        }
      }
    },
    "fieldChangeRequest": {
      "type": "object",
      "required": ["change_type", "reason", "decision_impact", "consumers_to_update", "sample_cases"],
      "additionalProperties": false,
      "properties": {
        "change_type": {
          "enum": ["create_field", "merge_fields", "split_field", "deprecate_field", "add_alias", "keep_as_observation"]
        },
        "field_id": { "type": "string" },
        "target_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggested_field": { "type": "object" },
        "reason": { "type": "string", "minLength": 1 },
        "decision_impact": { "type": "string", "minLength": 1 },
        "consumers_to_update": {
          "type": "array",
          "items": {
            "enum": [
              "fact_catalog",
              "prompt",
              "rule_engine",
              "validator",
              "regression_tests",
              "explanation_template",
              "historical_migration"
            ]
          }
        },
        "sample_cases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

