{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LBAI Fact Catalog v1",
  "type": "object",
  "required": ["schema_version", "domain", "fields"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "fact_catalog_v1" },
    "domain": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "id",
        "title",
        "layer",
        "lifecycle",
        "type",
        "definition",
        "unknown_policy",
        "conflict_policy",
        "consumer_rules",
        "owner",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "layer": {
          "enum": ["raw_evidence", "base_facts", "derived_facts", "decision_state", "metadata"]
        },
        "lifecycle": {
          "enum": ["formal_decision", "formal_supporting", "observation", "candidate", "deprecated"]
        },
        "type": {
          "enum": ["string", "number", "integer", "boolean", "enum", "date", "money"]
        },
        "enum": {
          "type": "array",
          "items": { "type": ["string", "number", "boolean"] },
          "uniqueItems": true
        },
        "unit": { "type": "string" },
        "definition": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "positive_examples": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "negative_examples": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "source_priority": {
          "type": "array",
          "items": {
            "enum": ["contract", "erp", "crm", "invoice_system", "email", "human_input", "user_text", "derived_rule"]
          },
          "default": []
        },
        "unknown_policy": {
          "enum": ["allow_unknown", "allow_unknown_and_request_fact", "block_until_known", "derive_if_possible"]
        },
        "conflict_policy": {
          "enum": ["ask_human", "prefer_system", "prefer_latest", "prefer_source_priority", "block"]
        },
        "consumer_rules": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "owner": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "replaced_by": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "enum" } },
            "required": ["type"]
          },
          "then": { "required": ["enum"] }
        }
      ]
    }
  }
}

