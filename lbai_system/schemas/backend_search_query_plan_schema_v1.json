{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LBAI Backend Search Query Plan v1",
  "type": "object",
  "required": ["schema_version", "query"],
  "properties": {
    "schema_version": { "const": "backend_search_query_plan_v1" },
    "query": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "concepts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entity_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prefer_status": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "additionalProperties": true
}
